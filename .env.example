# Your Revyl API key (Revyl dashboard -> Settings -> API keys).
REVYL_API_KEY=
# The id of a Revyl web app. Any web app works; the agent opens the game URL on it.
REVYL_APP_ID=

# Optional: how long to play, in seconds (the tutorial alone takes about 2.5 minutes), and how many runs.
# PLAY_SECONDS=360
# RUNS=3
